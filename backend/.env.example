# Hourglass backend の環境変数サンプル
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://hourglass:hourglass@localhost:5432/hourglass
# mobile の GoogleService-Info.plist / google-services.json の PROJECT_ID と一致させる
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Firebase Admin SDK 用の service account JSON (オプション)。
# 未指定の場合は gcloud の Application Default Credentials が使われる。
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# dev-mock-<uid> 形式のトークンを検証せずに受け入れる。実機 Firebase ログインを
# 検証する場合でも、dev テストユーザ並走のため true のままで良い。
DEV_MOCK_AUTH_ENABLED=true
LOCAL_JUDGMENT_ENABLED=true
LOG_LEVEL=INFO

# --- LLM 判定 ---
# local: ルールベースのダミー判定 (画像未対応, 提出すると NotImplementedError)
# gemini: Gemini Developer API でテキスト / 画像どちらも判定
LLM_PROVIDER=gemini
# gemini を使う場合は必須。https://aistudio.google.com/ で取得
LLM_GEMINI_API_KEY=AIza...（取得したキー）
LLM_GEMINI_MODEL=gemini-3-flash-preview
# Gemini 3 系で使う thinking level (minimal/low/medium/high)。未指定なら標準
# LLM_GEMINI_THINKING_LEVEL=medium
LLM_GEMINI_TEMPERATURE=0.2
# 画像判定で割り当てるトークン解像度 (low/medium/high)。手書きノートは high 推奨
LLM_GEMINI_IMAGE_MEDIA_RESOLUTION=high
LLM_TIMEOUT_SECONDS=30


# --- GCS (アウトプット画像保存) ---
# 設定しなければ画像アップロード API は 503 を返す (text 判定は問題なく動く)
# bucket を所有する GCP プロジェクト ID
GCS_PROJECT_ID=hourglass-f10ca
# 画像を格納する GCS バケット名 (lifecycle 7 日 / CORS 設定済み前提)
GCS_OUTPUT_IMAGE_BUCKET=puttokei-output-images-staging
# mobile に渡す upload URL の有効期限 (秒)
GCS_SIGNED_UPLOAD_URL_TTL_SECONDS=600
# 履歴表示用の download URL の有効期限 (秒)
GCS_SIGNED_DOWNLOAD_URL_TTL_SECONDS=900
# 画像 1 枚あたりの最大サイズ (バイト)。デフォルト 5MB
OUTPUT_IMAGE_MAX_BYTES=5242880

# --- GCS 認証 ---
# signed URL を発行するにはサービスアカウントキー (JSON) が必要。
# Storage Object Admin ロールを GCS bucket に付与したサービスアカウントの鍵を指定する。
# Cloud Run など workload identity 環境では IAM signBlob 経路の対応が別途必要。
# GCS_CREDENTIALS_PATH=/absolute/path/to/hourglass-sa-key.json
