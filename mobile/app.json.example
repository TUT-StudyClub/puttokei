{
  "_comment": [
    "チーム共通のテンプレート。`mobile/app.json` (gitignored) に複製して、",
    "`YOUR_*` で示したプレースホルダを各プロジェクト固有の値に書き換えて使う。",
    "EAS Build では `.easignore` で `app.json` を除外するため `app.json.example` が",
    "そのまま読まれる。CI / 配布で使うプロジェクト固有値はチーム内で共有して、",
    "個別開発者の overlay は `app.json` または `.env.local` の `EXPO_PUBLIC_*` を使う。"
  ],
  "expo": {
    "name": "Hourglass",
    "slug": "hourglass",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hourglass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.hourglass.dev",
      "googleServicesFile": "./GoogleService-Info.dev.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "アウトプット画像を撮影するためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "アウトプット画像を写真フォルダから選択するために写真ライブラリを使用します。",
        "NSMicrophoneUsageDescription": "アウトプット音声を文字起こしするためにマイクを使用します。",
        "NSSpeechRecognitionUsageDescription": "アウトプット音声を文字起こしするために音声認識を使用します。"
      },
      "appleTeamId": "YOUR_APPLE_TEAM_ID"
    },
    "android": {
      "package": "com.hourglass.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "./plugins/withFmtCompat",
      "@react-native-firebase/app",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "YOUR_REVERSED_CLIENT_ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "アウトプット画像を撮影するためにカメラを使用します。",
          "photosPermission": "アウトプット画像を写真フォルダから選択するために写真ライブラリを使用します。",
          "microphonePermission": "アウトプット音声を文字起こしするためにマイクを使用します。"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "アウトプット音声を文字起こしするためにマイクを使用します。",
          "speechRecognitionPermission": "アウトプット音声を文字起こしするために音声認識を使用します。",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logos/typography_black.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "http://localhost:8080/api/v1",
      "googleWebClientId": "YOUR_GOOGLE_WEB_CLIENT_ID",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "owner": "YOUR_EXPO_OWNER"
  }
}
