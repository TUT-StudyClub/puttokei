{
  "expo": {
    "name": "Hourglass",
    "slug": "hourglass",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hourglass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hourglass-nomibress.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hourglass.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4498f1e9-6c92-4c40-976d-8135bf225a8c"
      }
    },
    "owner": "yuehiyamada"
  }
}
