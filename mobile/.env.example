# 各自の開発環境向け上書き値。
# このファイルはテンプレートです。具体値は書かず、`.env.local` にコピーしてから埋めます。
#
# 使い方:
#   1. `cp .env.example .env.local`
#   2. `.env.local` の `EXPO_PUBLIC_*` を埋める
#   3. `task ios:device` などで build すると Expo CLI が `.env.local` を自動で読み込む
#
# `.env.local` と `app.json` は `.gitignore` で除外されています。
# 複雑な config tree を上書きしたい場合だけ、任意で `app.json.example` を `app.json` に
# コピーして overlay として使ってください。

# === チーム共通値 (Slack / Notion / 1Password / EAS Cloud env 等で共有されているものを貼る) ===

# Google Sign-In の Web client ID (Firebase Console -> Authentication -> Google で取得)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Sign-In の iOS URL scheme (= REVERSED_CLIENT_ID 形式)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# EAS プロジェクト ID (= app.json.example の extra.eas.projectId 相当)
EXPO_PUBLIC_EAS_PROJECT_ID=

# Expo アカウントの owner
EXPO_PUBLIC_EAS_OWNER=

# === 個人差項目 ===

# Apple Developer Team ID
# - Apple Developer Program 加入済の人: チーム共通値を貼る
# - 未加入の人: Apple Developer Portal の自分の Personal Team ID
EXPO_PUBLIC_APPLE_TEAM_ID=

# iOS の bundleIdentifier / Android の package
# - 加入済: com.hourglass.dev (チーム共通)
# - 未加入: com.hourglass.dev.<your-name> 等で被らない値に
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# backend API の base URL (各自の PC の LAN IP)
# 例: http://192.168.X.X:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=

# Firebase iOS 設定ファイル (各自の Bundle ID で登録した plist のパス)
# 例: ./GoogleService-Info.dev.plist
EXPO_PUBLIC_GOOGLE_SERVICES_IOS=
