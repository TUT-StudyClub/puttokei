# 各自の開発環境向け上書き値。
#
# 使い方:
#   1. プロジェクト固有の識別子を `app.json.example` から `app.json` にコピーして埋める
#        cp app.json.example app.json
#        # app.json を編集し YOUR_APPLE_TEAM_ID / YOUR_REVERSED_CLIENT_ID /
#        # YOUR_GOOGLE_WEB_CLIENT_ID / YOUR_EAS_PROJECT_ID / YOUR_EXPO_OWNER を実値に置換
#   2. このファイルを `.env.local` としてコピーする
#        cp .env.example .env.local
#   3. 自分の Bundle ID と LAN IP に書き換える
#   4. `task ios:device` などで build すると Expo CLI が `.env.local` を自動で読み込み、
#      `app.config.js` がここで指定した値で `app.json` (overlay) と `app.json.example`
#      (デフォルト) を順に上書きする
#
# `.env.local` と `app.json` は `.gitignore` で除外されているため、書き換えても他メンバー
# に影響しない。
# EAS Build (TestFlight / App Store) では `.easignore` で `app.json` を送らず、
# `app.json.example` を読むため、CI に必要な実値はチームで共有してから埋める運用にする。

# iOS の bundleIdentifier / Android の package。
# Apple Developer Program 未加入のメンバーは Personal Team で被らない値にする。
#   例: com.hourglass.dev.alice / com.hourglass.dev.bob
# Apple Developer Program 加入済 (Bundle ID = com.hourglass.dev のオーナー) は未指定で OK。
EXPO_PUBLIC_BUNDLE_IDENTIFIER=com.hourglass.dev.your-name

# backend API の base URL。`task backend:dev` を起動している PC の LAN IP に合わせる。
#   例: http://192.168.1.100:8080/api/v1
# `ifconfig | grep 'inet ' | grep -v 127.0.0.1` などで自分の LAN IP を確認する。
EXPO_PUBLIC_API_BASE_URL=http://192.168.X.X:8080/api/v1

# 使用する Firebase iOS 設定ファイル。共用 dev plist で問題ない場合はそのまま。
# 個人ごとの Bundle ID で Firebase iOS App を分けたい場合は、ダウンロードした plist を
# `mobile/GoogleService-Info.dev.<name>.plist` などに置いて、ここでパス指定する。
EXPO_PUBLIC_GOOGLE_SERVICES_IOS=./GoogleService-Info.dev.plist
